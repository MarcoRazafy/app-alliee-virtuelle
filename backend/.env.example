# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/alliee_virtuelle

# JWT
JWT_SECRET=your_super_secret_key_here_min_32_chars_long
JWT_EXPIRY=7d

# Environment
NODE_ENV=development
API_PORT=3001

# Mistral (phase 2)
MISTRAL_API_KEY=your_mistral_key_here
MISTRAL_MODEL=mistral-medium

# SSL PostgreSQL : auto (activé si NODE_ENV=production) sauf si forcé ici (true|false).
# À forcer seulement pour un cas particulier (Postgres auto-hébergé sans TLS, etc.).
# DATABASE_SSL=

# Monitoring d'erreurs OPTIONNEL (Sentry). Laisser vide = désactivé.
# Pour activer : npm i @sentry/node (dans backend/) puis renseigner le DSN.
# SENTRY_DSN=

# Amorçage automatique du 1er administrateur au démarrage (déploiement).
# Si ces 3 variables sont définies, l'admin est créé au boot (idempotent : ignoré s'il existe).
# NE JAMAIS committer le mot de passe : le définir dans les variables de l'hébergeur (Railway…).
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_USERNAME=   # facultatif (sinon dérivé de l'email)

# Planning hebdomadaire : fuseau horaire organisationnel utilisé pour toute la logique
# de fenêtre de saisie (samedi 00h00 -> dimanche 23h59), indépendamment du serveur/navigateur.
PLANNING_TIMEZONE=Indian/Antananarivo
PRESENCE_HEARTBEAT_TIMEOUT_SECONDS=60
PRESENCE_DISCONNECT_GRACE_SECONDS=30
PRESENCE_CLEANUP_INTERVAL_SECONDS=10

# Bascule de TEST/DEMO uniquement : force la fenêtre de saisie employé à rester ouverte
# en permanence (au lieu de samedi/dimanche seulement). Toujours "false" en production.
PLANNING_FORCE_EDIT_WINDOW=false
